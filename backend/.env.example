# ============================================
# 财务报销审核系统 - 环境配置模板
# 复制为项目根目录 .env 并填入真实值
# ============================================

# ---------- 应用配置 ----------
APP_NAME=Expense Audit System
APP_ENV=development
DEBUG=True
SECRET_KEY=change-me-to-a-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- 数据库配置 ----------
# MySQL：需先建库 CREATE DATABASE expense_db CHARACTER SET utf8mb4;
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/expense_db?charset=utf8mb4
# 如使用 PostgreSQL：DATABASE_URL=postgresql://user:password@localhost:5432/expense_db

# ---------- Redis 配置 ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Celery 任务队列（AI审核worker） ----------
# broker用db1、任务结果用db2（db0已被报表缓存占用）；本地需先启动Redis
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- LLM 配置（GLM 智谱） ----------
GLM_API_KEY=your-glm-api-key
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
MODEL_NAME=glm-5.1
EMBEDDING_MODEL_NAME=embedding-3
TEMPERATURE=0.3
MAX_TOKENS=2048

# ---------- OCR 混合流水线（可选，默认hybrid） ----------
# OCR_PROVIDER=hybrid  # hybrid=混合流水线；off=保持占位行为
# VLM_MODEL_NAME=glm-4.1v-flash  # OCR的VLM兜底模型
# OCR_MIN_CONFIDENCE=0.85  # RapidOCR分支的路由阈值(平均置信度)

# ---------- AI审核策略 ----------
AGENT_REVIEW_ON_SUBMIT=True
RISK_LOW_MAX=40
RISK_HIGH_MIN=70
EMBEDDING_DIMENSIONS=1024

# ---------- 向量数据库配置 ----------
# Milvus standalone实例地址（开发连局域网远程实例；容器部署时改为http://milvus:19530等）
MILVUS_URI=http://localhost:19530

# ---------- 文件存储配置 ----------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ---------- JWT 配置 ----------
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ---------- 邮件配置（可选，不填则通知降级为日志） ----------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notify@example.com
# SMTP_PASSWORD=your-password

# ---------- 日志配置 ----------
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ---------- CORS 配置 ----------
# 5173=Vite开发服务器，8080=nginx生产入口
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
