# ============================================
# 财务报销审核系统 - 环境配置模板
# 复制为项目根目录 .env 并填入真实值
# ============================================

# ---------- 应用配置 ----------
APP_NAME=Expense Audit System
APP_ENV=development
DEBUG=True
SECRET_KEY=change-me-to-a-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- 数据库配置 ----------
# MySQL：需先建库 CREATE DATABASE expense_db CHARACTER SET utf8mb4;
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/expense_db?charset=utf8mb4
# 如使用 PostgreSQL：DATABASE_URL=postgresql://user:password@localhost:5432/expense_db

# ---------- Redis 配置 ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Celery 任务队列（AI审核worker） ----------
# broker用db1、任务结果用db2（db0已被报表缓存占用）；本地需先启动Redis
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- LLM 配置（Kimi for Coding 订阅，OpenAI兼容） ----------
# sk-kimi-密钥只认订阅端点/coding/v1，与api.moonshot.cn、api.kimi.com/v1互不相认
LLM_API_KEY=your-kimi-api-key
LLM_API_BASE=https://api.kimi.com/coding/v1
MODEL_NAME=k3
# 思考力度low/high/max：思考token计入MAX_TOKENS
LLM_REASONING_EFFORT=low
MAX_TOKENS=8192

# ---------- RAG 向量检索（本机Ollama嵌入） ----------
RAG_PROVIDER=milvus
# 嵌入：本机Ollama跑Qwen3-Embedding（先ollama pull qwen3-embedding:8b）
# key为占位值——Ollama不校验，但OpenAI SDK要求非空
EMBEDDING_API_KEY=ollama
EMBEDDING_API_BASE=http://localhost:11434/v1
EMBEDDING_MODEL_NAME=qwen3-embedding:8b
# Qwen3-Embedding-8B输出维度（32-4096可自定义，默认4096）
EMBEDDING_DIMENSIONS=4096

# ---------- OCR 混合流水线（可选，默认hybrid） ----------
# OCR_PROVIDER=hybrid  # hybrid=混合流水线；off=保持占位行为
# VLM_MODEL_NAME=k3  # OCR的VLM兜底模型（K3原生支持图片输入）
# OCR_MIN_CONFIDENCE=0.85  # RapidOCR分支的路由阈值(平均置信度)

# ---------- AI审核策略 ----------
AGENT_REVIEW_ON_SUBMIT=True
RISK_LOW_MAX=40
RISK_HIGH_MIN=70

# ---------- 向量数据库配置 ----------
# Milvus standalone实例地址（开发连局域网远程实例；容器部署时改为http://milvus:19530等）
MILVUS_URI=http://localhost:19530

# ---------- 文件存储配置 ----------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ---------- JWT 配置 ----------
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ---------- 邮件配置（可选，不填则通知降级为日志） ----------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notify@example.com
# SMTP_PASSWORD=your-password

# ---------- 日志配置 ----------
# 控制台：每个 /api 请求一行式日志「方法 路径?query → 状态（耗时）+ 请求体（敏感字段打码）」
# uvicorn 原生访问行对 /api 去重；前端轮询接口静音；非 /api（静态资源等）照常；级别名着色
# 完整日志（含全部访问日志）写入 LOG_FILE
# LOG_FILE 10MB×5 自动轮转；留空（LOG_FILE=）禁用文件日志；路径不可写时自动降级为仅控制台
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ---------- CORS 配置 ----------
# 5173=Vite开发服务器，8080=nginx生产入口
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
